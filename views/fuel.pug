block content

// ================= CSS =================
link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet")
link(rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css")
link(rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css")
link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css")

// ================= STYLE =================
style.
  .dataTables_wrapper .dataTables_length{
    float:left;
    width:50%;
    margin-bottom:10px;
  }

  .dataTables_wrapper .dt-buttons{
    width:20%;
    text-align:right;
    margin:0 0 10px 0;
  }

  .dt-buttons .btn{
    margin-left:5px;
    font-size:14px;
  }

  table.dataTable tbody td{
    vertical-align:middle;
  }


// ================= PAGE =================
.container-fluid.mt-3

  .row.mb-3.align-items-end

    .col-md-5
      label.form-label Start Date
      input.form-control#startDate(type="date")

    .col-md-5
      label.form-label End Date
      input.form-control#endDate(type="date")

    .col-md-2.text-end
      button.btn.btn-warning.w-100(
        data-bs-toggle="modal"
        data-bs-target="#addFuelModal"
      ) Add New +

  // ================= TABLE =================
  table#fuelTable.table.table-bordered.table-hover

    thead
      tr.text-center.bg-light
        th Date
        th Odometer
        th Liters
        th Amount
        th Price/Liter
        th Filled
        th Mileage
        th Note
        th Action

    tbody
      each item in fuelEntries
        - const d = new Date(item.date)

        tr(data-date=d.toISOString())

          td.text-center= d.toLocaleString('en-IN', { dateStyle:'short', timeStyle:'short' })
          td.text-center= item.odometer || 0
          td.text-center= item.liters || 0
          td.text-center= item.amount || 0
          td.text-center= item.pricePerLiter || 0
          td.text-center "-"
          td.text-center= item.mileage || ""
          td= item.note || "-"

          td.text-center
            button.btn.btn-sm.btn-light.border.me-1(
              data-bs-toggle="modal"
              data-bs-target=`#edit${item.id}`
            ) Edit

            form(action=`/delete/${item.id}` method="POST" style="display:inline;")
              button.btn.btn-sm.btn-danger(type="submit") Delete


// ================= ADD MODAL =================
.modal.fade#addFuelModal
  .modal-dialog
    .modal-content

      .modal-header
        h5.modal-title Fuel Entry
        button.btn-close(type="button" data-bs-dismiss="modal")

      form(action="/" method="POST")

        .modal-body

          .mb-3
            label Date
            input.form-control#addFuelDate(type="text" name="date")

          .mb-3
            label Liters
            input.form-control(type="number" step="0.01" name="liters")

          .mb-3
            label Amount
            input.form-control(type="number" step="0.01" name="amount")

          .mb-3
            label Price/Liter
            input.form-control(type="number" step="0.01" name="pricePerLiter")

          .mb-3
            label Odometer
            input.form-control(type="number" name="odometer")

          .mb-3
            label Mileage
            input.form-control(type="number" step="0.01" name="mileage")

          .mb-3
            label Note
            textarea.form-control(name="note")

        .modal-footer
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
          button.btn.btn-warning(type="submit") Save


// ================= EDIT MODAL =================
each item in fuelEntries
  .modal.fade(id=`edit${item.id}`)
    .modal-dialog
      .modal-content

        .modal-header
          h5.modal-title Edit Fuel Entry
          button.btn-close(type="button" data-bs-dismiss="modal")

        form(action=`/update/${item.id}` method="POST")

          .modal-body

            - const ed = new Date(item.date)

            .mb-2
              label Date
              input.form-control.fuel-date(
                type="text"
                name="date"
                value=ed.toLocaleString('en-IN', {
                  day:'2-digit',
                  month:'2-digit',
                  year:'numeric',
                  hour:'2-digit',
                  minute:'2-digit',
                  hour12:true
                })
              )

            .mb-2
              label Odometer
              input.form-control(type="number" name="odometer" value=item.odometer)

            .mb-2
              label Liters
              input.form-control(type="number" step="0.01" name="liters" value=item.liters)

            .mb-2
              label Amount
              input.form-control(type="number" step="0.01" name="amount" value=item.amount)

            .mb-2
              label Price/Liter
              input.form-control(type="number" step="0.01" name="pricePerLiter" value=item.pricePerLiter)

            .mb-2
              label Mileage
              input.form-control(type="number" step="0.01" name="mileage" value=item.mileage)

            .mb-2
              label Note
              textarea.form-control(name="note")= item.note

          .modal-footer
            button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
            button.btn.btn-primary(type="submit") Update


// ================= JS =================
script(src="https://code.jquery.com/jquery-3.7.1.min.js")
script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js")
script(src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js")
script(src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js")
script(src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js")
script(src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js")
script(src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js")
script(src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js")
script(src="https://cdn.jsdelivr.net/npm/flatpickr")

script.
  $(function () {

    let table = $('#fuelTable').DataTable({
      pageLength: 20,
      order: [[0,'desc']]
    });

    // ================= FILTER FIX =================
    $.fn.dataTable.ext.search.push(function(settings, data, dataIndex){

      let start = $('#startDate').val();
      let end = $('#endDate').val();

      let rowDate = new Date($('#fuelTable tbody tr').eq(dataIndex).data('date'));

      let startDate = start ? new Date(start) : null;
      let endDate = end ? new Date(end) : null;

      return (
        (!startDate && !endDate) ||
        (!startDate && rowDate <= endDate) ||
        (startDate <= rowDate && !endDate) ||
        (startDate <= rowDate && rowDate <= endDate)
      );
    });

    $('#startDate, #endDate').on('change', function(){
      table.draw();
    });

    // ================= FLATPICKR =================
    flatpickr("#addFuelDate", {
      enableTime: true,
      dateFormat: "d/m/Y h:i K",
      defaultDate: new Date()
    });

    flatpickr(".fuel-date", {
      enableTime: true,
      dateFormat: "d/m/Y h:i K",
      allowInput: true
    });

  });