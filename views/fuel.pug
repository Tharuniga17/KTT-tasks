block content

  // CSS
  link(
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
  )

  link(
    rel="stylesheet",
    href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css"
  )

  link(
    rel="stylesheet",
    href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css"
  )

  link(
    rel="stylesheet",
    href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"
  )


  style.

    /* show entries */
    .dataTables_wrapper .dataTables_length{
      float:left;
      width:50%;
      margin-bottom:10px;
    }

    /* copy excel */
    .dataTables_wrapper .dt-buttons{
      float:center;
      width:20%;
      text-align:right;
      margin:0 0 10px 0;
    }

    .dt-buttons .btn{
      margin-left:5px;
      font-size:14px;
    }

    .dataTables_wrapper .dataTables_filter{
      clear:both;
    }

    table.dataTable tbody td{
      vertical-align:middle;
    }



  .container-fluid.mt-3

    // DATE FILTERS
    .row.mb-3.align-items-end

      .col-md-5
        label.form-label Start Date :
        input.form-control#startDate(type="date")

      .col-md-5
        label.form-label End Date :
        input.form-control#endDate(type="date")

      .col-md-2.text-end
        button.btn.btn-warning.w-100(
          data-bs-toggle="modal"
          data-bs-target="#addFuelModal"
        ) Add New +



    // TABLE
    table#fuelTable.table.table-bordered.table-hover

      thead
        tr.bg-light.text-center
          th Date
          th Odometer
          th Liters
          th Amount
          th Price/Liter
          th Filled
          th Mileage
          th Note
          th Action

      tbody

        each item in fuelEntries

          tr

            td= item.date

            td.text-center= item.odometer

            td.text-center= item.liters

            td.text-center= item.amount

            td.text-center= item.pricePerLiter

            td.text-center -

            td.text-center= item.mileage == null ? "" : item.mileage

            td= item.note || "-"

            td.text-center

              button.btn.btn-sm.btn-light.border.me-1(
                data-bs-toggle="modal"
                data-bs-target=`#edit${item.id}`
              ) Edit


              form(
                action=`/delete/${item.id}`
                method="POST"
                style="display:inline;"
              )

                button.btn.btn-sm.btn-danger(
                  type="submit"
                ) Delete



      tfoot.bg-light

        tr.fw-bold.text-center

          td(colspan="2").text-end Total

          td.text-center= summary.total_liters

          td.text-center= summary.total_amount 

          td.text-center= Number(summary.avg_price).toFixed(2) 

          td Avg 

          td 0

          td

          td



    // EDIT MODALS
    each item in fuelEntries

      .modal.fade(id=`edit${item.id}`)

        .modal-dialog

          .modal-content

            .modal-header

              h5.modal-title Edit Fuel Entry

              button.btn-close(
                type="button"
                data-bs-dismiss="modal"
              )


            form(
              action=`/update/${item.id}`
              method="POST"
            )

              .modal-body

                .mb-2
                  label Date
                  input.form-control.fuel-date(
                    type="text"
                    name="date"
                    value=item.date
                  )


                .mb-2
                  label Odometer
                  input.form-control(
                    type="number"
                    name="odometer"
                    value=item.odometer
                  )


                .mb-2
                  label Liters
                  input.form-control(
                    type="number"
                    name="liters"
                    value=item.liters
                  )


                .mb-2
                  label Amount
                  input.form-control(
                    type="number"
                    name="amount"
                    value=item.amount
                  )


                .mb-2
                  label Price/Liter
                  input.form-control(
                    type="number"
                    name="pricePerLiter"
                    value=item.pricePerLiter
                  )


                .mb-2
                  label Mileage
                  input.form-control(
                    type="number"
                    name="mileage"
                    value=item.mileage
                  )


                .mb-2
                  label Note
                  textarea.form-control(
                    name="note"
                  )= item.note


              .modal-footer

                button.btn.btn-secondary(
                  data-bs-dismiss="modal"
                  type="button"
                ) Close


                button.btn.btn-primary(
                  type="submit"
                ) Update




    // ADD MODAL
    .modal.fade#addFuelModal

      .modal-dialog

        .modal-content

          .modal-header

            h5.modal-title Fuel Entry

            button.btn-close(
              type="button"
              data-bs-dismiss="modal"
            )


          form(action="/" method="POST")

            .modal-body

              .mb-3
                label Date
                input.form-control#addFuelDate(
                  type="text"
                  name="date"
                  required
                )


              .mb-3
                label Liters
                input.form-control(
                  type="number"
                  name="liters"
                )


              .mb-3
                label Amount
                input.form-control(
                  type="number"
                  name="amount"
                )


              .mb-3
                label Price/Liter
                input.form-control(
                  type="number"
                  name="pricePerLiter"
                )


              .mb-3
                label Odometer
                input.form-control(
                  type="number"
                  name="odometer"
                )


              .mb-3
                label Mileage
                input.form-control(
                  type="number"
                  name="mileage"
                )


              .mb-3
                label Note
                textarea.form-control(
                  name="note"
                )


            .modal-footer

              button.btn.btn-secondary(
                type="button"
                data-bs-dismiss="modal"
              ) Close


              button.btn.btn-warning(
                type="submit"
              ) Save



  // JS
  script(src="https://code.jquery.com/jquery-3.7.1.min.js")

  script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js")

  script(src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js")
  script(src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js")

  script(src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js")
  script(src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js")

  script(src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js")

  script(src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js")

  script(src="https://cdn.jsdelivr.net/npm/flatpickr")



  script.

    $(function(){


      function parseDate(str){

        let parts = str.split(" ");

        let dateParts = parts[0].split("/");

        return new Date(
          dateParts[2],
          dateParts[1]-1,
          dateParts[0]
        );
      }



      $.fn.dataTable.ext.search.push(

        function(settings,data){

          let min = $('#startDate').val();

          let max = $('#endDate').val();

          let rowDate = parseDate(data[0]);


          if(min){
            min = new Date(min);
          }

          if(max){
            max = new Date(max);
          }


          if(
            (!min && !max) ||
            (!min && rowDate <= max) ||
            (min <= rowDate && !max) ||
            (min <= rowDate && rowDate <= max)
          ){
            return true;
          }

          return false;
        }

      );



      let table = $('#fuelTable').DataTable({

        pageLength:20,

        lengthMenu:[
          [20,50,100],
          [20,50,100]
        ],

        order:[[0,'desc']],

        dom:'lBfrtip',

        buttons:[
          {
            extend:'copy',
            text:'Copy',
            className:'btn btn-light border'
          },
          {
            extend:'excel',
            text:'Excel',
            className:'btn btn-light border'
          }
        ]

      });



      $('#startDate,#endDate').on(
        'change',
        function(){
          table.draw();
        }
      );



      const addPicker = flatpickr(
        "#addFuelDate",
        {
          enableTime:true,
          dateFormat:"d/m/Y h:i K",
          defaultDate:new Date()
        }
      );



      flatpickr(
        ".fuel-date",
        {
          enableTime:true,
          dateFormat:"d/m/Y h:i K"
        }
      );



      $('#addFuelModal').on(
        'show.bs.modal',
        function(){
          addPicker.setDate(
            new Date(),
            true
          );
        }
      );


    });